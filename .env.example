# The backend's address, without a path. Defaults to the production API when unset.
# VITE_API_BASE_URL=https://collab-api-ewju.onrender.com
# Google Identity Services web client ID. Add every site origin under "Authorized JavaScript origins" in Google Cloud.
# VITE_GOOGLE_CLIENT_ID=591280470035-mamos86blk66gpr7bufpv48ln9dntsef.apps.googleusercontent.com
# Trial (C10): creators can send a bid before the ID check; the check is asked for once a bid is accepted. "1" turns it
# on; unset or anything else keeps today's flow (verify first, then bid). Needs the backend to accept unverified bids.
# VITE_TRIAL_BID_BEFORE_KYC=1
